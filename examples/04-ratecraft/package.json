{
  "name": "ratecraft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "RAYON_NUM_THREADS=2 UV_THREADPOOL_SIZE=2 bun --bun vite --host 127.0.0.1 --port 43104 --strictPort",
    "build": "RAYON_NUM_THREADS=2 UV_THREADPOOL_SIZE=2 bun --bun vite build",
    "start": "bun .output/server/index.mjs",
    "typecheck": "bun --bun tsc --noEmit",
    "lint": "bun --bun oxlint --threads 2 --deny-warnings src vite.config.ts vitest.config.ts",
    "format": "bun --bun oxfmt --threads 2 --write .",
    "format:check": "bun --bun oxfmt --threads 2 --check .",
    "test": "bun --bun vitest run --maxWorkers 2",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "@solidjs/start": "2.0.6",
    "solid-js": "1.9.17",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "nitro": "3.0.260903-beta",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
